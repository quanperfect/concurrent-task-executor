function(cte_project_options target)
    set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
    target_compile_features(${target} PRIVATE cxx_std_20)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow)
        if(CTE_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
        if(CTE_SANITIZER STREQUAL "thread")
            target_compile_options(${target} PRIVATE -fsanitize=thread -g -O1 -fno-omit-frame-pointer)
            target_link_options(${target} PUBLIC -fsanitize=thread)
        elseif(CTE_SANITIZER STREQUAL "address-undefined")
            target_compile_options(${target} PRIVATE -fsanitize=address,undefined -g -O1 -fno-omit-frame-pointer)
            target_link_options(${target} PUBLIC -fsanitize=address,undefined)
        elseif(NOT CTE_SANITIZER STREQUAL "none")
            message(FATAL_ERROR "Unknown CTE_SANITIZER: ${CTE_SANITIZER}")
        endif()
    elseif(NOT CTE_SANITIZER STREQUAL "none")
        message(FATAL_ERROR "The requested sanitizer profile requires GCC or Clang")
    endif()
endfunction()
